REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="mivmandate2010@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=jan-conf
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

CONFERENCE_STARTS_AT=2027-01-19T17:00:00+01:00
CONFERENCE_ONSITE_CAPACITY=2500

# Filled in when the matching feature ships
PAYSTACK_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payments: "fake" is a built-in mock of Paystack (dev/demo only; refused in production). Use "paystack" with real keys to go live.
PAYMENT_DRIVER=fake
PAYSTACK_SECRET_KEY=

